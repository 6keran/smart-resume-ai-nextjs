/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js & builds
.next/
**/.next/
/out/
/build
dist/
**/dist/
scratch/

# sqlite WAL/SHM
*.db-shm
*.db-wal

# misc
.DS_Store
*.pem
/certificates

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local secrets
.env
.env.*
!.env.example
!.env.template

