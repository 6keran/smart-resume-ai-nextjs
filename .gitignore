scripts/.chrome_*/
scripts/.edge_*/
scripts/login_*.png
scripts/analyze_dump.mjs
scripts/downloaded_layout.js
scripts/extracted_mockData.js
scripts/extract_mockdata_err.mjs

# Generated Edge diagnostic profiles
