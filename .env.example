# Smart Resume AI - Environment Configuration
# Copy this file to .env.local to configure API keys.

# Google Gemini API Key (for live AI resume analysis)
GEMINI_API_KEY=

# Adzuna Job Search API (Sign up for free developer keys at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble Job Search API (Sign up for free API key at https://jooble.org/api/about)
JOOBLE_API_KEY=
