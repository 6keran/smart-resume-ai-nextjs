# Smart Resume AI - Environment Configuration
# Copy this file to .env.local to configure API keys.

# Session Security Secret (Required in production: minimum 32 random characters for HMAC SHA-256)
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Google Gemini API Key (for live AI resume analysis and career chatbot)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# Job Search APIs (Optional for extended job feeds)
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=

# Database Configuration
# Local development defaults to SQLite (data/smart_resume.db).
# For production Neon PostgreSQL, configure POSTGRES_URL:
POSTGRES_URL="postgresql://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DB_PROVIDER="sqlite" # Set to "postgres" to force PostgreSQL